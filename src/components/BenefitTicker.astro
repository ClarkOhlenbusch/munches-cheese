---
// BenefitTicker.astro
---

<div class="relative z-30 w-full bg-munches-cream border-y-4 border-munches-navy py-4 shadow-pop-sm overflow-hidden">
  
  <!-- Marquee Container -->
  <div class="flex items-center whitespace-nowrap animate-marquee-infinite">
    
    <!-- Group 1 -->
    <div class="flex items-center gap-6 sm:gap-10 text-xs sm:text-sm font-black uppercase text-munches-navy tracking-wider px-4">
      
      <div class="flex items-center gap-2">
        <svg class="w-5 h-5 text-munches-green fill-current" viewBox="0 0 24 24">
          <path d="M17,8C8,10 5.9,16.17 3.82,21.34L5.71,22L6.66,19.7C7.14,19.87 7.64,20 8,20C19,20 22,3 22,3C21,5 14,5.25 9,6.25C4,7.25 2,11.5 2,13.5C2,15.5 3.75,17.25 3.75,17.25C7,8 17,8 17,8Z"/>
        </svg>
        <span>REAL INGREDIENTS</span>
      </div>

      <span class="text-munches-orange font-black text-lg">|</span>

      <div class="flex items-center gap-2">
        <span class="text-lg">💪</span>
        <span>7G PROTEIN</span>
      </div>

      <span class="text-munches-orange font-black text-lg">|</span>

      <div class="flex items-center gap-2">
        <span class="text-lg text-munches-navy">💙</span>
        <span>80 CALORIES</span>
      </div>

      <span class="text-munches-orange font-black text-lg">|</span>

      <div class="flex items-center gap-2">
        <span class="text-lg text-munches-yellow">☀️</span>
        <span>A BRIGHTER YOU</span>
      </div>

      <span class="text-munches-orange font-black text-lg">|</span>

      <div class="flex items-center gap-2">
        <span class="text-base text-munches-orange">🧀</span>
        <span>THE CHEESE STICK CHEAT CODE</span>
      </div>

      <span class="text-munches-orange font-black text-lg">|</span>

      <div class="flex items-center gap-2">
        <span class="text-xs bg-munches-navy text-munches-yellow px-2 py-0.5 rounded-full font-black">PEEL. SNACK. REPEAT. ◡</span>
      </div>

      <span class="text-munches-orange font-black text-lg">|</span>

      <div class="flex items-center gap-2">
        <span class="text-lg text-munches-green">✓</span>
        <span>ZERO ADDED SUGAR</span>
      </div>

      <span class="text-munches-orange font-black text-lg">|</span>

      <div class="flex items-center gap-2">
        <span class="text-base">📦</span>
        <span>FLIP-TOP POCKET PACK</span>
      </div>

      <span class="text-munches-orange font-black text-lg">|</span>

    </div>

    <!-- Duplicate for Seamless Infinite Loop -->
    <div class="flex items-center gap-6 sm:gap-10 text-xs sm:text-sm font-black uppercase text-munches-navy tracking-wider px-4" aria-hidden="true">
      
      <div class="flex items-center gap-2">
        <svg class="w-5 h-5 text-munches-green fill-current" viewBox="0 0 24 24">
          <path d="M17,8C8,10 5.9,16.17 3.82,21.34L5.71,22L6.66,19.7C7.14,19.87 7.64,20 8,20C19,20 22,3 22,3C21,5 14,5.25 9,6.25C4,7.25 2,11.5 2,13.5C2,15.5 3.75,17.25 3.75,17.25C7,8 17,8 17,8Z"/>
        </svg>
        <span>REAL INGREDIENTS</span>
      </div>

      <span class="text-munches-orange font-black text-lg">|</span>

      <div class="flex items-center gap-2">
        <span class="text-lg">💪</span>
        <span>7G PROTEIN</span>
      </div>

      <span class="text-munches-orange font-black text-lg">|</span>

      <div class="flex items-center gap-2">
        <span class="text-lg text-munches-navy">💙</span>
        <span>80 CALORIES</span>
      </div>

      <span class="text-munches-orange font-black text-lg">|</span>

      <div class="flex items-center gap-2">
        <span class="text-lg text-munches-yellow">☀️</span>
        <span>A BRIGHTER YOU</span>
      </div>

      <span class="text-munches-orange font-black text-lg">|</span>

      <div class="flex items-center gap-2">
        <span class="text-base text-munches-orange">🧀</span>
        <span>THE CHEESE STICK CHEAT CODE</span>
      </div>

      <span class="text-munches-orange font-black text-lg">|</span>

      <div class="flex items-center gap-2">
        <span class="text-xs bg-munches-navy text-munches-yellow px-2 py-0.5 rounded-full font-black">PEEL. SNACK. REPEAT. ◡</span>
      </div>

      <span class="text-munches-orange font-black text-lg">|</span>

      <div class="flex items-center gap-2">
        <span class="text-lg text-munches-green">✓</span>
        <span>ZERO ADDED SUGAR</span>
      </div>

      <span class="text-munches-orange font-black text-lg">|</span>

      <div class="flex items-center gap-2">
        <span class="text-base">📦</span>
        <span>FLIP-TOP POCKET PACK</span>
      </div>

      <span class="text-munches-orange font-black text-lg">|</span>

    </div>

  </div>
</div>
