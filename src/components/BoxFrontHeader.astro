---
// BoxFrontHeader.astro
// Exact 1:1 translation of the Munches cheese stick carton front into a responsive website header/hero section
import MunchesMascot from "./MunchesMascot.astro";
---

<div id="hero" class="relative w-full min-h-screen bg-[#FFFDF5] flex flex-col justify-between overflow-hidden select-none">

  <!-- ========================================================================= -->
  <!-- 0. OFF-WHITE DOMINANT BACKGROUND WITH ABSTRACT ASYMMETRICAL ORANGE ACCENTS-->
  <!-- ========================================================================= -->
  <div class="absolute inset-0 w-full h-full pointer-events-none z-0 overflow-hidden">
    <svg 
      viewBox="0 0 1440 900" 
      preserveAspectRatio="none" 
      class="w-full h-full"
      xmlns="http://www.w3.org/2000/svg"
    >
      <!-- 1. BASE OFF-WHITE (Dominates the entire canvas ~85%) -->
      <rect width="1440" height="900" fill="#FFFDF5" />

      <!-- 2. ABSTRACT, NON-UNIFORM ORANGE MELT ACCENTS -->
      <!-- Melted cheese organic wave rising from bottom-right behind Munchie mascot -->
      <path 
        d="
          M 1440, 460
          C 1340, 450 1260, 510 1195, 575
          C 1130, 640 1080, 695 1010, 725
          C 930, 760 870, 790 830, 840
          C 795, 882 785, 900 770, 900
          L 1440, 900
          Z
        " 
        fill="#FA4616" 
      />

      <!-- Organic melted wave outline / accent glow -->
      <path 
        d="
          M 1440, 460
          C 1340, 450 1260, 510 1195, 575
          C 1130, 640 1080, 695 1010, 725
          C 930, 760 870, 790 830, 840
          C 795, 882 785, 900 770, 900
        " 
        fill="none" 
        stroke="#E03A09" 
        stroke-width="3" 
        opacity="0.3" 
      />

      <!-- Subtle asymmetrical melted droplet at far bottom-left -->
      <path 
        d="M 0, 840 C 35, 840 65, 865 75, 890 C 78, 897 79, 900 80, 900 L 0, 900 Z" 
        fill="#FA4616" 
        opacity="0.9" 
      />

      <!-- Floating organic cheese bubbles / playful accents -->
      <circle cx="790" cy="800" r="14" fill="#FA4616" opacity="0.25" />
      <circle cx="740" cy="870" r="20" fill="#FA4616" opacity="0.18" />
      <circle cx="1020" cy="670" r="12" fill="#FA4616" opacity="0.2" />
      <circle cx="75" cy="280" r="14" fill="#FA4616" opacity="0.08" />
      <circle cx="1380" cy="220" r="18" fill="#FA4616" opacity="0.08" />
    </svg>
  </div>

  <!-- ========================================================================= -->
  <!-- 1. TOP HEADER / BRAND NAVIGATION BAR                                      -->
  <!-- ========================================================================= -->
  <header class="relative z-40 w-full px-4 sm:px-8 py-4 flex items-center justify-between">
    
    <!-- Left: Brand Tag Pill -->
    <a href="#hero" class="flex items-center gap-2 bg-[#FFFDF5] border-3 border-[#0B62C4] px-4 py-1.5 rounded-full shadow-[3px_3px_0px_#0B62C4] hover:scale-105 active:scale-95 transition-all">
      <span class="text-lg leading-none">🧀</span>
      <span class="font-bubble text-sm sm:text-base font-black text-[#FA4616] tracking-wider">MUNCHES™</span>
    </a>

    <!-- Center/Right: Section Navigation Links (Tied to upcoming page sections) -->
    <nav class="flex items-center gap-1 sm:gap-2 md:gap-3">
      <a 
        href="#the-snack" 
        class="hidden sm:inline-block font-bubble text-xs sm:text-sm font-black text-[#0B62C4] hover:text-[#FA4616] px-2.5 sm:px-3 py-1.5 rounded-full hover:bg-[#FFE042]/50 transition-colors uppercase tracking-wider"
      >
        The Snack
      </a>
      <a 
        href="#macros" 
        class="hidden md:inline-block font-bubble text-xs sm:text-sm font-black text-[#0B62C4] hover:text-[#FA4616] px-2.5 sm:px-3 py-1.5 rounded-full hover:bg-[#FFE042]/50 transition-colors uppercase tracking-wider"
      >
        Macros
      </a>
      <a 
        href="#the-pack" 
        class="hidden sm:inline-block font-bubble text-xs sm:text-sm font-black text-[#0B62C4] hover:text-[#FA4616] px-2.5 sm:px-3 py-1.5 rounded-full hover:bg-[#FFE042]/50 transition-colors uppercase tracking-wider"
      >
        The Pack
      </a>
      <a 
        href="#find-stores" 
        class="font-bubble text-xs sm:text-sm font-black text-[#0B62C4] bg-[#FFE042] border-2 border-[#0B62C4] px-3 sm:px-4 py-1.5 rounded-full shadow-[2px_2px_0px_#0B62C4] hover:scale-105 active:scale-95 transition-all uppercase tracking-wider whitespace-nowrap"
      >
        Find Stores
      </a>
    </nav>
  </header>

  <!-- ========================================================================= -->
  <!-- 2. THE MAIN BOX FRONT CANVAS (Prominent Logo & Hero Experience)           -->
  <!-- ========================================================================= -->
  <main id="box-front-canvas" class="relative z-10 flex-1 flex flex-col justify-between w-full max-w-[1440px] mx-auto px-4 sm:px-8 pt-6 sm:pt-10 md:pt-12 lg:pt-14 pb-0">

    <!-- --------------------------------------------------------------------- -->
    <!-- TOP ARCH: "MUNCHES™" WORDMARK (LOWER IN SCREEN, CLEAN 3D TYPOGRAPHY)   -->
    <!-- --------------------------------------------------------------------- -->
    <div class="relative w-full flex flex-col items-center text-center mt-2 sm:mt-4 md:mt-6">
      
      <!-- Arched MUNCHES Logo Wrapper with Subtle Floating Animation -->
      <div 
        id="munches-logo-wrap"
        class="floating-logo-wrap relative w-full flex justify-center cursor-pointer group"
        title="MUNCHES™"
      >
        <svg 
          viewBox="0 0 1180 240" 
          class="w-full max-w-[1220px] xl:max-w-[1320px] 2xl:max-w-[1400px] h-auto overflow-visible filter drop-shadow-[0_16px_36px_rgba(250,70,22,0.12)] transition-transform duration-300"
          xmlns="http://www.w3.org/2000/svg"
        >
          <defs>
            <!-- Clean, Smooth 3D Block Extrusion Filter -->
            <filter id="clean-letter-extrusion" x="-20%" y="-20%" width="140%" height="160%">
              <feDropShadow dx="0" dy="4" stdDeviation="0" flood-color="#E03A09" />
              <feDropShadow dx="0" dy="9" stdDeviation="0" flood-color="#C52B02" />
              <feDropShadow dx="0" dy="14" stdDeviation="0" flood-color="#9C1E00" />
              <feDropShadow dx="0" dy="16" stdDeviation="6" flood-color="#FA4616" flood-opacity="0.22" />
            </filter>
            
            <!-- Cream letter face gradient -->
            <linearGradient id="cream-face" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0%" stop-color="#FFFFFF" />
              <stop offset="35%" stop-color="#FFFDF7" />
              <stop offset="70%" stop-color="#FDF1D8" />
              <stop offset="100%" stop-color="#F6DCAC" />
            </linearGradient>
          </defs>

          <style>
            .m-back {
              font-family: 'Titan One', cursive, sans-serif;
              font-size: 185px;
              text-anchor: middle;
              fill: #FA4616;
              stroke: #FA4616;
              stroke-width: 18px;
              stroke-linejoin: round;
              stroke-linecap: round;
            }
            .m-face {
              font-family: 'Titan One', cursive, sans-serif;
              font-size: 185px;
              text-anchor: middle;
              fill: url(#cream-face);
              stroke: #FA4616;
              stroke-width: 3.5px;
              stroke-linejoin: round;
              paint-order: fill stroke;
            }

            /* --- Sequential Bouncy Entrance Animation (Left-to-Right) --- */
            @keyframes letter-pop {
              0% {
                opacity: 0;
                transform: translateY(-80px) scale(0.7);
              }
              55% {
                opacity: 1;
                transform: translateY(10px) scale(1.14, 0.88);
              }
              75% {
                transform: translateY(-5px) scale(0.97, 1.03);
              }
              90% {
                transform: translateY(2px) scale(1.01, 0.99);
              }
              100% {
                opacity: 1;
                transform: translateY(0) scale(1, 1);
              }
            }

            /* Sparkle Burst upon Impact & Hover */
            @keyframes sparkle-pop {
              0% {
                opacity: 0;
                transform: scale(0) rotate(0deg);
              }
              35% {
                opacity: 1;
                transform: scale(1.6) rotate(45deg);
              }
              65% {
                opacity: 0.9;
                transform: scale(1.2) rotate(70deg) translateY(-8px);
              }
              100% {
                opacity: 0;
                transform: scale(0.2) rotate(90deg) translateY(-22px);
              }
            }

            /* Minimal, Gentle Floating Loop */
            @keyframes logo-floating {
              0%, 100% {
                transform: translateY(0px) rotate(0deg);
              }
              50% {
                transform: translateY(-7px) rotate(0.35deg);
              }
            }

            .letter-unit {
              transform-box: fill-box;
              transform-origin: center bottom;
              animation: letter-pop 0.48s cubic-bezier(0.34, 1.56, 0.64, 1) both;
            }

            .letter-0 { animation-delay: 0.06s; }
            .letter-1 { animation-delay: 0.16s; }
            .letter-2 { animation-delay: 0.26s; }
            .letter-3 { animation-delay: 0.36s; }
            .letter-4 { animation-delay: 0.46s; }
            .letter-5 { animation-delay: 0.56s; }
            .letter-6 { animation-delay: 0.66s; }
            .letter-7 { animation-delay: 0.78s; } /* TM */

            /* Individual Interactive Letter Hover State */
            .letter-interactive {
              transform-box: fill-box;
              transform-origin: center bottom;
              transition: transform 0.28s cubic-bezier(0.34, 1.56, 0.64, 1), filter 0.28s ease;
              cursor: pointer;
              pointer-events: all;
            }

            .letter-interactive:hover,
            .letter-interactive.is-hovered {
              transform: translateY(-22px) scale(1.14);
              filter: drop-shadow(0 16px 24px rgba(250, 70, 22, 0.55));
            }

            .letter-interactive:active {
              transform: translateY(-8px) scale(1.04, 0.94);
              transition-duration: 0.1s;
            }

            /* Hover Sparkles triggered on individual letter hover */
            .hover-sparkle-group {
              opacity: 0;
              transform-box: fill-box;
              transform-origin: center center;
              pointer-events: none;
              transition: opacity 0.15s ease;
            }

            .letter-interactive:hover .hover-sparkle-group,
            .letter-interactive.is-hovered .hover-sparkle-group {
              opacity: 1;
              animation: sparkle-pop 0.52s ease-out forwards;
            }

            /* Initial Page-Load Sparkle Burst upon Impact */
            .sparkle-group {
              transform-box: fill-box;
              transform-origin: center center;
              pointer-events: none;
            }

            .sparkle-0 { animation: sparkle-pop 0.52s ease-out 0.28s both; }
            .sparkle-1 { animation: sparkle-pop 0.52s ease-out 0.38s both; }
            .sparkle-2 { animation: sparkle-pop 0.52s ease-out 0.48s both; }
            .sparkle-3 { animation: sparkle-pop 0.52s ease-out 0.58s both; }
            .sparkle-4 { animation: sparkle-pop 0.52s ease-out 0.68s both; }
            .sparkle-5 { animation: sparkle-pop 0.52s ease-out 0.78s both; }
            .sparkle-6 { animation: sparkle-pop 0.52s ease-out 0.88s both; }
            .sparkle-7 { animation: sparkle-pop 0.52s ease-out 0.98s both; }

            .floating-logo-wrap {
              animation: logo-floating 4.5s ease-in-out 1.25s infinite;
            }
          </style>

          <!-- Letter M -->
          <g class="letter-unit letter-0">
            <g class="letter-interactive" data-letter="M" data-index="0">
              <g filter="url(#clean-letter-extrusion)">
                <text class="m-back" transform="translate(150, 160) rotate(-10)">M</text>
                <text class="m-face" transform="translate(150, 160) rotate(-10)">M</text>
              </g>
              <g class="hover-sparkle-group">
                <path d="M 95 80 Q 95 95 85 95 Q 95 95 95 110 Q 95 95 105 95 Q 95 95 95 80 Z" fill="#FFE042" />
                <path d="M 160 85 Q 160 95 152 95 Q 160 95 160 105 Q 160 95 168 95 Q 160 95 160 85 Z" fill="#FA4616" />
                <circle cx="115" cy="70" r="4" fill="#FFE042" />
              </g>
            </g>
            <g class="sparkle-group sparkle-0">
              <path d="M 95 80 Q 95 95 85 95 Q 95 95 95 110 Q 95 95 105 95 Q 95 95 95 80 Z" fill="#FFE042" />
              <path d="M 160 85 Q 160 95 152 95 Q 160 95 160 105 Q 160 95 168 95 Q 160 95 160 85 Z" fill="#FA4616" />
              <circle cx="115" cy="70" r="4" fill="#FFE042" />
            </g>
          </g>

          <!-- Letter U -->
          <g class="letter-unit letter-1">
            <g class="letter-interactive" data-letter="U" data-index="1">
              <g filter="url(#clean-letter-extrusion)">
                <text class="m-back" transform="translate(290, 140) rotate(-6)">U</text>
                <text class="m-face" transform="translate(290, 140) rotate(-6)">U</text>
              </g>
              <g class="hover-sparkle-group">
                <path d="M 255 50 Q 255 65 245 65 Q 255 65 255 80 Q 255 65 265 65 Q 255 65 255 50 Z" fill="#FFE042" />
                <circle cx="320" cy="55" r="4" fill="#FA4616" />
              </g>
            </g>
            <g class="sparkle-group sparkle-1">
              <path d="M 255 50 Q 255 65 245 65 Q 255 65 255 80 Q 255 65 265 65 Q 255 65 255 50 Z" fill="#FFE042" />
              <circle cx="320" cy="55" r="4" fill="#FA4616" />
            </g>
          </g>

          <!-- Letter N -->
          <g class="letter-unit letter-2">
            <g class="letter-interactive" data-letter="N" data-index="2">
              <g filter="url(#clean-letter-extrusion)">
                <text class="m-back" transform="translate(425, 128) rotate(-2)">N</text>
                <text class="m-face" transform="translate(425, 128) rotate(-2)">N</text>
              </g>
              <g class="hover-sparkle-group">
                <path d="M 420 30 Q 420 45 410 45 Q 420 45 420 60 Q 420 45 430 45 Q 420 45 420 30 Z" fill="#FFE042" />
                <circle cx="455" cy="45" r="4" fill="#FA4616" />
              </g>
            </g>
            <g class="sparkle-group sparkle-2">
              <path d="M 420 30 Q 420 45 410 45 Q 420 45 420 60 Q 420 45 430 45 Q 420 45 420 30 Z" fill="#FFE042" />
              <circle cx="455" cy="45" r="4" fill="#FA4616" />
            </g>
          </g>

          <!-- Letter C -->
          <g class="letter-unit letter-3">
            <g class="letter-interactive" data-letter="C" data-index="3">
              <g filter="url(#clean-letter-extrusion)">
                <text class="m-back" transform="translate(560, 125) rotate(0)">C</text>
                <text class="m-face" transform="translate(560, 125) rotate(0)">C</text>
              </g>
              <g class="hover-sparkle-group">
                <path d="M 560 25 Q 560 40 550 40 Q 560 40 560 55 Q 560 40 570 40 Q 560 40 560 25 Z" fill="#FFE042" />
                <circle cx="600" cy="35" r="4" fill="#FFE042" />
              </g>
            </g>
            <g class="sparkle-group sparkle-3">
              <path d="M 560 25 Q 560 40 550 40 Q 560 40 560 55 Q 560 40 570 40 Q 560 40 560 25 Z" fill="#FFE042" />
              <circle cx="600" cy="35" r="4" fill="#FFE042" />
            </g>
          </g>

          <!-- Letter H -->
          <g class="letter-unit letter-4">
            <g class="letter-interactive" data-letter="H" data-index="4">
              <g filter="url(#clean-letter-extrusion)">
                <text class="m-back" transform="translate(695, 128) rotate(2)">H</text>
                <text class="m-face" transform="translate(695, 128) rotate(2)">H</text>
              </g>
              <g class="hover-sparkle-group">
                <path d="M 695 30 Q 695 45 685 45 Q 695 45 695 60 Q 695 45 705 45 Q 695 45 695 30 Z" fill="#FFE042" />
                <circle cx="665" cy="45" r="4" fill="#FA4616" />
              </g>
            </g>
            <g class="sparkle-group sparkle-4">
              <path d="M 695 30 Q 695 45 685 45 Q 695 45 695 60 Q 695 45 705 45 Q 695 45 695 30 Z" fill="#FFE042" />
              <circle cx="665" cy="45" r="4" fill="#FA4616" />
            </g>
          </g>

          <!-- Letter E -->
          <g class="letter-unit letter-5">
            <g class="letter-interactive" data-letter="E" data-index="5">
              <g filter="url(#clean-letter-extrusion)">
                <text class="m-back" transform="translate(830, 140) rotate(6)">E</text>
                <text class="m-face" transform="translate(830, 140) rotate(6)">E</text>
              </g>
              <g class="hover-sparkle-group">
                <path d="M 855 50 Q 855 65 845 65 Q 855 65 855 80 Q 855 65 865 65 Q 855 65 855 50 Z" fill="#FFE042" />
                <circle cx="795" cy="55" r="4" fill="#FA4616" />
              </g>
            </g>
            <g class="sparkle-group sparkle-5">
              <path d="M 855 50 Q 855 65 845 65 Q 855 65 855 80 Q 855 65 865 65 Q 855 65 855 50 Z" fill="#FFE042" />
              <circle cx="795" cy="55" r="4" fill="#FA4616" />
            </g>
          </g>

          <!-- Letter S -->
          <g class="letter-unit letter-6">
            <g class="letter-interactive" data-letter="S" data-index="6">
              <g filter="url(#clean-letter-extrusion)">
                <text class="m-back" transform="translate(965, 160) rotate(10)">S</text>
                <text class="m-face" transform="translate(965, 160) rotate(10)">S</text>
              </g>
              <g class="hover-sparkle-group">
                <path d="M 985 75 Q 985 90 975 90 Q 985 90 985 105 Q 985 90 995 90 Q 985 90 985 75 Z" fill="#FFE042" />
                <circle cx="1020" cy="100" r="4" fill="#FA4616" />
              </g>
            </g>
            <g class="sparkle-group sparkle-6">
              <path d="M 985 75 Q 985 90 975 90 Q 985 90 985 105 Q 985 90 995 90 Q 985 90 985 75 Z" fill="#FFE042" />
              <circle cx="1020" cy="100" r="4" fill="#FA4616" />
            </g>
          </g>

          <!-- 3. TM Superscript in Orange at Top Right of 'S' with Auto-Fitting SVG Scaling -->
          <g class="letter-unit letter-7">
            <g class="letter-interactive" data-letter="TM" data-index="7">
              <text 
                x="1065" 
                y="95" 
                font-family="'Titan One', cursive, sans-serif" 
                font-size="28" 
                fill="#FA4616" 
                letter-spacing="1"
              >
                TM
              </text>
              <g class="hover-sparkle-group">
                <path d="M 1095 55 Q 1095 65 1088 65 Q 1095 65 1095 75 Q 1095 65 1102 65 Q 1095 65 1095 55 Z" fill="#FFE042" />
              </g>
            </g>
            <g class="sparkle-group sparkle-7">
              <path d="M 1095 55 Q 1095 65 1088 65 Q 1095 65 1095 75 Q 1095 65 1102 65 Q 1095 65 1095 55 Z" fill="#FFE042" />
            </g>
          </g>
        </svg>
      </div>

    </div>

    <!-- --------------------------------------------------------------------- -->
    <!-- MIDDLE STAGE BELOW MUNCHES: "SMALL SNACKS BIGGER DAYS" & MASCOT       -->
    <!-- --------------------------------------------------------------------- -->
    <div class="relative w-full mt-4 sm:mt-6 md:mt-8 grid grid-cols-1 lg:grid-cols-12 gap-6 lg:gap-8 items-end max-w-5xl mx-auto flex-1 pb-0">

      <!-- =================================================================== -->
      <!-- ZONE 1: "SMALL SNACKS BIGGER DAYS" COPY (LEFT / CENTER)             -->
      <!-- =================================================================== -->
      <div class="lg:col-span-7 flex flex-col items-center lg:items-start text-center lg:text-left z-20 px-2 pb-6 sm:pb-10 lg:pb-14">
        
        <!-- Exact Tilted Royal Blue Lettering from the Box Face with Energy Rays -->
        <div class="relative inline-block select-none my-2">
          <div class="inline-block transform -rotate-6 hover:rotate-0 transition-transform cursor-pointer">
            <div class="font-bubble text-4xl sm:text-5xl md:text-6xl font-black text-[#0B62C4] leading-[0.92] tracking-wide text-center lg:text-left drop-shadow-[0_2px_0_rgba(255,255,255,0.6)]">
              SMALL<br/>
              SNACKS<br/>
              BIGGER<br/>
              DAYS
            </div>
            <!-- Underline dash from packaging -->
            <div class="w-24 h-2.5 bg-[#0B62C4] rounded-full mx-auto lg:mx-0 mt-2.5 shadow-sm"></div>
          </div>

          <!-- 3 Energy Rays from Packaging (pointing to mascot) -->
          <div class="absolute -right-7 sm:-right-10 top-1/4 flex flex-col gap-1.5 pointer-events-none">
            <span class="inline-block w-5 sm:w-7 h-1.5 bg-[#FFE042] rounded-full transform rotate-12 shadow-xs"></span>
            <span class="inline-block w-6 sm:w-8 h-1.5 bg-[#FFE042] rounded-full transform rotate-0 shadow-xs"></span>
            <span class="inline-block w-5 sm:w-7 h-1.5 bg-[#FFE042] rounded-full transform -rotate-12 shadow-xs"></span>
          </div>
        </div>

        <!-- Brand Slogan Hook -->
        <div class="mt-4 max-w-md flex flex-col items-center lg:items-start">
          <p class="font-bubble text-xl sm:text-2xl md:text-3xl font-black text-[#0B62C4] leading-snug tracking-tight">
            “A little something to take the edge off”
          </p>
        </div>

      </div>

      <!-- =================================================================== -->
      <!-- ZONE 2: ELONGATED MOZZARELLA STICK MASCOT (CUT OFF AT BOTTOM)       -->
      <!-- =================================================================== -->
      <div class="lg:col-span-5 flex flex-col items-center lg:items-end justify-end z-20 self-end">
        
        <!-- THE MASCOT: Elongated Mozzarella Stick with Sunglasses & Rays, bottom cleanly cut off -->
        <div 
          id="mascot-stage"
          class="relative cursor-pointer select-none transition-transform duration-300 ease-out flex items-end justify-center"
          title="Munchie"
        >
          <MunchesMascot class="w-52 sm:w-60 md:w-68 lg:w-76 xl:w-80 h-auto block" id="hero-munchie-mascot" />
        </div>

      </div>

    </div>

  </main>

</div>

<!-- Client Scripts for Mouse Parallax and Confetti -->
<script is:inline>
  // 1. Interactive 3D Cursor Parallax Tilt
  const mascot = document.getElementById('mascot-stage');
  const logo = document.getElementById('munches-logo-wrap');

  if (window.matchMedia('(pointer: fine)').matches) {
    document.addEventListener('mousemove', (e) => {
      const { innerWidth, innerHeight } = window;
      const x = (e.clientX - innerWidth / 2) / (innerWidth / 2);
      const y = (e.clientY - innerHeight / 2) / (innerHeight / 2);

      if (mascot) {
        mascot.style.transform = `perspective(1000px) rotateY(${x * 8}deg) rotateX(${-y * 6}deg) translateY(${y * 4}px)`;
      }
      if (logo) {
        logo.style.transform = `translateY(${y * 4}px) rotate(${x * 0.6}deg)`;
      }
    });
  }

  // 2. Tactile Letter & Mascot Confetti Click Handlers (No SFX)
  const letterInteractives = document.querySelectorAll('.letter-interactive');
  letterInteractives.forEach((letterEl) => {
    letterEl.addEventListener('click', (e) => {
      e.stopPropagation();
      if (typeof confetti === 'function') {
        const rect = letterEl.getBoundingClientRect();
        const x = (rect.left + rect.width / 2) / window.innerWidth;
        const y = (rect.top + rect.height / 2) / window.innerHeight;
        confetti({
          particleCount: 22,
          spread: 45,
          origin: { x, y },
          colors: ['#FA4616', '#FFE042', '#FFF5DF', '#0B62C4']
        });
      }
    });
  });

  if (logo) {
    logo.addEventListener('click', () => {
      if (typeof confetti === 'function') {
        confetti({
          particleCount: 45,
          spread: 75,
          origin: { y: 0.25 },
          colors: ['#FA4616', '#FFE042', '#FFF5DF', '#0B62C4']
        });
      }
    });
  }

  if (mascot) {
    mascot.addEventListener('click', () => {
      if (typeof confetti === 'function') {
