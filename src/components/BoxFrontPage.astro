---
// BoxFrontPage.astro - The entire first page is literally the front of the box, nothing else
---

<div class="relative w-full min-h-screen bg-[#FA4616] flex items-center justify-center overflow-hidden select-none p-2 sm:p-6">
  
  <!-- Subtle warm background glow -->
  <div class="absolute inset-0 pointer-events-none overflow-hidden">
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[700px] h-[700px] bg-[#FF622E] rounded-full blur-3xl opacity-40"></div>
  </div>

  <!-- Sound Toggle in the corner -->
  <button 
    id="sound-toggle-btn"
    title="Toggle Audio FX"
    class="fixed top-4 right-4 z-50 w-10 h-10 rounded-full bg-[#FFFDF5] border-2 border-[#0B62C4] flex items-center justify-center text-sm shadow-[2px_2px_0px_#0B62C4] hover:scale-105 active:scale-95 transition-transform"
  >
    <span id="sound-icon">🔊</span>
  </button>

  <!-- ========================================================================= -->
  <!-- THE BOX: FRONT AND CENTER, TAKING UP THE FULL SCREEN                      -->
  <!-- Exactly how it looks, nothing else.                                       -->
  <!-- ========================================================================= -->
  <div 
    id="munches-box-stage"
    class="relative z-10 flex items-center justify-center w-full max-w-4xl h-[92vh] max-h-[92vh] cursor-pointer transition-transform duration-300 ease-out"
    style="animation: subtleFloat 5s ease-in-out infinite;"
    title="Click to interact with the pack"
  >
    <img 
      id="munches-box-img"
      src="/munches-box-hero-transparent.png" 
      alt="Munches Original Mozzarella Cheese Sticks Carton Front" 
      class="h-full w-auto max-w-full object-contain filter drop-shadow-[0_25px_35px_rgba(0,0,0,0.35)] hover:brightness-105 transition-all"
    />
  </div>

</div>

<script is:inline>
  // Interactive 3D cursor parallax tilt
  const stage = document.getElementById('munches-box-stage');
  if (stage && window.matchMedia('(pointer: fine)').matches) {
    document.addEventListener('mousemove', (e) => {
      const { innerWidth, innerHeight } = window;
      const x = (e.clientX - innerWidth / 2) / (innerWidth / 2);
      const y = (e.clientY - innerHeight / 2) / (innerHeight / 2);
      // Subtle 3D perspective tilt
      stage.style.transform = `perspective(1200px) rotateX(${-y * 6}deg) rotateY(${x * 6}deg) translateY(${y * 4}px)`;
    });

    document.addEventListener('mouseleave', () => {
      stage.style.transform = 'perspective(1200px) rotateX(0deg) rotateY(0deg) translateY(0px)';
    });
  }

  // Audio click sound
  stage?.addEventListener('click', () => {
    if (window.MunchesSound) {
      window.MunchesSound.playFlipPack();
      setTimeout(() => window.MunchesSound.playStickPull(), 150);
    }
  });

  // Sound toggle button
  const soundBtn = document.getElementById('sound-toggle-btn');
  const soundIcon = document.getElementById('sound-icon');
  if (soundBtn && soundIcon) {
    soundBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      if (window.MunchesSound) {
        window.MunchesSound.enabled = !window.MunchesSound.enabled;
        soundIcon.textContent = window.MunchesSound.enabled ? '🔊' : '🔇';
      }
    });
  }
</script>
