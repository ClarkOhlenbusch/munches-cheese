---
// src/components/CampaignSection.astro
// Big large main campaign section featuring the official Munches advertisement poster
---

<section id="the-snack" class="relative w-full bg-[#FFFDF5] py-16 sm:py-24 px-4 sm:px-8 overflow-hidden border-b-4 border-[#0B62C4]">
  
  <!-- Subtle decorative ambient blobs -->
  <div class="absolute inset-0 pointer-events-none opacity-35 overflow-hidden">
    <div class="absolute -right-24 top-1/4 w-96 h-96 bg-[#FFE042]/30 rounded-full blur-3xl"></div>
    <div class="absolute -left-24 bottom-1/4 w-96 h-96 bg-[#FA4616]/15 rounded-full blur-3xl"></div>
  </div>

  <div class="relative z-10 max-w-6xl mx-auto flex flex-col items-center">
    
    <!-- Clean, bold header without pill tags -->
    <h2 class="reveal-on-scroll font-bubble text-3xl sm:text-5xl md:text-6xl font-black text-[#0B62C4] text-center leading-[1.05] tracking-tight max-w-4xl">
      JUST A LITTLE SOMETHING TO TAKE THE EDGE OFF
    </h2>

    <p class="reveal-on-scroll font-bold text-sm sm:text-base md:text-lg text-[#0B62C4]/80 text-center max-w-2xl mt-4 leading-relaxed">
      Crafted from 100% Wisconsin whole milk, packed fresh into a rigid flip-top pocket carton. Same great cheese. Brighter attitude.
    </p>

    <!-- The Big Advertisement Poster Showcase -->
    <div class="w-full flex flex-col items-center mt-12 sm:mt-16">
      
      <div 
        id="campaign-poster-stage" 
        class="reveal-scale relative group max-w-3xl w-full bg-white border-4 border-[#0B62C4] rounded-3xl sm:rounded-[36px] overflow-hidden shadow-[10px_10px_0px_#0B62C4] sm:shadow-[16px_16px_0px_#0B62C4] hover:-translate-y-1.5 transition-all duration-300 select-none"
      >
        <!-- The Official Munches Advertisement Poster -->
        <img 
          src="/munches-poster.png" 
          alt="Munches Original Mozzarella Cheese Sticks Official Campaign Poster" 
          class="w-full h-auto object-cover block"
        />

        <!-- Subtle Inner Highlight Ring -->
        <div class="absolute inset-0 pointer-events-none rounded-3xl sm:rounded-[36px] border border-white/40"></div>
      </div>

    </div>

    <!-- 4 Brand Value Highlight Cards Under Poster -->
    <div class="w-full grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 mt-12 sm:mt-16">
      
      <!-- Highlight 1 -->
      <div class="reveal-on-scroll bg-white border-3 border-[#0B62C4] rounded-3xl p-6 shadow-[5px_5px_0px_#0B62C4] hover:-translate-y-1 transition-transform">
        <div class="text-3xl mb-3">🧀</div>
        <h3 class="font-bubble text-lg sm:text-xl font-black text-[#FA4616] leading-snug">
          100% WHOLE MILK
        </h3>
        <p class="text-xs sm:text-sm font-bold text-[#0B62C4]/80 mt-2 leading-relaxed">
          Real Wisconsin whole-milk mozzarella. Creamy, rich, and pulls like fresh cheese should.
        </p>
      </div>

      <!-- Highlight 2 -->
      <div class="reveal-on-scroll bg-white border-3 border-[#0B62C4] rounded-3xl p-6 shadow-[5px_5px_0px_#0B62C4] hover:-translate-y-1 transition-transform" style="transition-delay: 100ms;">
        <div class="text-3xl mb-3">💪</div>
        <h3 class="font-bubble text-lg sm:text-xl font-black text-[#0B62C4] leading-snug">
          7G CLEAN PROTEIN
        </h3>
        <p class="text-xs sm:text-sm font-bold text-[#0B62C4]/80 mt-2 leading-relaxed">
          Natural dairy casein delivers sustained focus and keeps you fueled with zero sugar crash.
        </p>
      </div>

      <!-- Highlight 3 -->
      <div class="reveal-on-scroll bg-white border-3 border-[#0B62C4] rounded-3xl p-6 shadow-[5px_5px_0px_#0B62C4] hover:-translate-y-1 transition-transform" style="transition-delay: 200ms;">
        <div class="text-3xl mb-3">📦</div>
        <h3 class="font-bubble text-lg sm:text-xl font-black text-[#FA4616] leading-snug">
          6 STANDING STICKS
        </h3>
        <p class="text-xs sm:text-sm font-bold text-[#0B62C4]/80 mt-2 leading-relaxed">
          Individually sealed and standing upright. A rigid pocket pack that never gets crushed in your bag.
        </p>
      </div>

      <!-- Highlight 4 -->
      <div class="reveal-on-scroll bg-white border-3 border-[#0B62C4] rounded-3xl p-6 shadow-[5px_5px_0px_#0B62C4] hover:-translate-y-1 transition-transform" style="transition-delay: 300ms;">
        <div class="text-3xl mb-3">◡</div>
        <h3 class="font-bubble text-lg sm:text-xl font-black text-[#0B62C4] leading-snug">
          PEEL • SNACK • REPEAT
        </h3>
        <p class="text-xs sm:text-sm font-bold text-[#0B62C4]/80 mt-2 leading-relaxed">
          One-handed peel tab lets you snack cleanly during meetings, drives, and workouts.
        </p>
      </div>

    </div>

  </div>
</section>

<script is:inline>
  const posterStage = document.getElementById('campaign-poster-stage');
  if (posterStage && window.matchMedia('(pointer: fine)').matches) {
    posterStage.addEventListener('mousemove', (e) => {
      const rect = posterStage.getBoundingClientRect();
      const x = (e.clientX - rect.left) / rect.width - 0.5;
      const y = (e.clientY - rect.top) / rect.height - 0.5;
      posterStage.style.transform = `perspective(900px) rotateY(${x * 6}deg) rotateX(${-y * 6}deg) translateY(-4px)`;
    });

    posterStage.addEventListener('mouseleave', () => {
      posterStage.style.transform = 'perspective(900px) rotateY(0deg) rotateX(0deg) translateY(0px)';
    });
  }
</script>
