---
// CartDrawer.astro
---

<!-- Slide-Out Cart Overlay -->
<div id="cart-drawer-overlay" class="fixed inset-0 bg-munches-navy/70 backdrop-blur-sm z-50 hidden transition-opacity duration-300">
  
  <!-- Drawer Panel -->
  <div 
    id="cart-drawer-panel" 
    class="fixed right-0 top-0 bottom-0 w-full max-w-md bg-munches-cream border-l-4 border-munches-navy p-6 flex flex-col justify-between shadow-2xl transform translate-x-full transition-transform duration-300 ease-out"
  >
    
    <!-- Drawer Header -->
    <div>
      <div class="flex items-center justify-between border-b-2 border-munches-navy/20 pb-4 mb-4">
        <div class="flex items-center gap-2">
          <span class="text-2xl">🧀</span>
          <h3 class="font-bubble text-2xl font-black text-munches-navy">YOUR CHEESE STASH</h3>
        </div>
        <button id="close-cart-btn" class="w-9 h-9 rounded-full bg-munches-yellow border-2 border-munches-navy flex items-center justify-center font-black text-base shadow-pop-sm hover:scale-110 active:scale-95 transition-transform">
          ✕
        </button>
      </div>

      <!-- Free Cold Shipping Progress Bar -->
      <div class="bg-munches-yellow border-2 border-munches-navy rounded-2xl p-3 mb-4 shadow-sm">
        <div class="flex justify-between text-[11px] font-black uppercase text-munches-navy mb-1.5">
          <span id="shipping-progress-text">ADD $15.00 MORE FOR FREE COLD SHIPPING</span>
          <span id="shipping-progress-percent">65%</span>
        </div>
        <div class="w-full h-2.5 bg-munches-cream rounded-full border border-munches-navy overflow-hidden">
          <div id="shipping-bar-fill" class="h-full bg-munches-orange transition-all duration-300" style="width: 65%;"></div>
        </div>
      </div>

      <!-- Protein Tally Pill -->
      <div class="bg-munches-sky/20 border border-munches-navy/30 rounded-xl p-2.5 flex items-center justify-between text-xs font-black text-munches-navy mb-4">
        <span>TOTAL STASH PROTEIN:</span>
        <span id="stash-protein-tally" class="bg-munches-navy text-munches-cream px-2 py-0.5 rounded-lg text-xs">
          0g Protein
        </span>
      </div>

      <!-- Cart Item List Container -->
      <div id="cart-items-container" class="space-y-3 max-h-[42vh] overflow-y-auto pr-1">
        <!-- Empty state placeholder -->
        <div id="cart-empty-state" class="text-center py-12">
          <div class="text-5xl mb-3">📦</div>
          <div class="font-bubble text-xl font-black text-munches-navy">Your Stash is Empty</div>
          <p class="text-xs font-semibold text-munches-navy/70 mt-1">
            Pick a pack from the lineup to take the edge off.
          </p>
        </div>
      </div>
    </div>

    <!-- Drawer Footer / Checkout -->
    <div class="border-t-2 border-munches-navy/20 pt-4 mt-4 bg-munches-cream">
      
      <!-- Subscription Option -->
      <div class="bg-munches-ivory border-2 border-munches-navy rounded-xl p-2.5 mb-3 flex items-center justify-between">
        <div class="flex items-center gap-2">
          <input type="checkbox" id="sub-toggle" class="w-4 h-4 rounded border-2 border-munches-navy accent-munches-orange cursor-pointer" />
          <label for="sub-toggle" class="text-[11px] font-black uppercase text-munches-navy cursor-pointer">
            DELIVER EVERY 2 WEEKS (SAVE 15%)
          </label>
        </div>
        <span class="text-[10px] font-black text-munches-orange bg-munches-yellow px-1.5 py-0.5 rounded">
          THE HABIT
        </span>
      </div>

      <!-- Subtotal Breakdown -->
      <div class="space-y-1.5 text-xs font-bold text-munches-navy mb-4">
        <div class="flex justify-between">
          <span>Stash Subtotal:</span>
          <span id="cart-subtotal" class="font-black text-sm">$0.00</span>
        </div>
        <div class="flex justify-between text-[11px]">
          <span>Insulated Cold Packaging:</span>
          <span class="text-munches-green font-black">FREE (With Ice Packs)</span>
        </div>
      </div>

      <!-- Checkout Button -->
      <button 
        id="cart-checkout-btn" 
        class="w-full btn-tactile bg-munches-orange text-munches-cream py-3.5 rounded-2xl font-bubble text-xl border-3 border-munches-navy shadow-pop-navy flex items-center justify-center gap-2"
      >
        <span>SECURE SNACK CHECKOUT</span>
        <span>➔</span>
      </button>

      <div class="text-center text-[10px] font-bold text-munches-navy/60 mt-2">
        🔒 100% Happiness Guarantee • Shipped In Insulated Eco-Boxes
      </div>
    </div>

  </div>
</div>

<!-- Checkout Success Celebration Modal -->
<div id="checkout-success-modal" class="fixed inset-0 z-50 bg-munches-navy/80 backdrop-blur-md hidden items-center justify-center p-4">
  <div class="bg-munches-cream border-4 border-munches-navy rounded-3xl p-6 sm:p-8 max-w-md w-full shadow-pop-navy-lg text-center">
    <div class="text-6xl mb-2">🎉🧀</div>
    <span class="bg-munches-yellow text-munches-navy text-[10px] font-black uppercase px-2.5 py-1 rounded-full border border-munches-navy">
      ORDER CONFIRMED #MUNCHES-8921
    </span>
    <h3 class="font-bubble text-3xl font-black text-munches-navy mt-3 mb-2">
      Your Stash Is Being Packed!
    </h3>
    <p class="text-xs font-semibold text-munches-navy/80 leading-relaxed mb-4">
      We've got your order queued. Your flip-top boxes are heading into the insulated cooler with dry ice packs. Your edge will be officially taken off in 2 business days.
    </p>

    <div class="bg-munches-ivory border-2 border-munches-navy rounded-2xl p-3 text-left text-xs font-black text-munches-navy mb-4 space-y-1">
      <div class="flex justify-between">
        <span>Estimated Delivery:</span>
        <span class="text-munches-orange">Thursday Morning</span>
      </div>
      <div class="flex justify-between">
        <span>Delivery Mode:</span>
        <span class="text-munches-green">Chilled Cold-Chain</span>
      </div>
    </div>

    <button id="close-success-modal-btn" class="w-full btn-tactile bg-munches-orange text-munches-cream py-3 rounded-2xl font-bubble text-lg border-2 border-munches-navy shadow-pop-sm">
      AWESOME, KEEP SNACKING
    </button>
  </div>
</div>

<script is:inline>
  // Simple Reactive Cart Store
  window.MunchesCart = {
    items: [],
    isOpen: false,
    
    addItem(name, price, proteinPerPack = 42) {
      const existing = this.items.find(i => i.name === name);
      if (existing) {
        existing.qty += 1;
      } else {
        this.items.push({ name, price: parseFloat(price), qty: 1, protein: proteinPerPack });
      }
      this.updateUI();
      this.open();
      if (window.MunchesSound) window.MunchesSound.playStickPull();
    },

    removeItem(name) {
      this.items = this.items.filter(i => i.name !== name);
      this.updateUI();
      if (window.MunchesSound) window.MunchesSound.playFlipPack();
    },

    changeQty(name, delta) {
      const item = this.items.find(i => i.name === name);
      if (item) {
        item.qty += delta;
        if (item.qty <= 0) {
          this.removeItem(name);
          return;
        }
      }
      this.updateUI();
    },

    open() {
      const overlay = document.getElementById('cart-drawer-overlay');
      const panel = document.getElementById('cart-drawer-panel');
      if (overlay && panel) {
        overlay.classList.remove('hidden');
        setTimeout(() => {
          panel.classList.remove('translate-x-full');
        }, 10);
      }
    },

    close() {
      const overlay = document.getElementById('cart-drawer-overlay');
      const panel = document.getElementById('cart-drawer-panel');
      if (overlay && panel) {
        panel.classList.add('translate-x-full');
        setTimeout(() => {
          overlay.classList.add('hidden');
        }, 300);
      }
    },

    updateUI() {
      const container = document.getElementById('cart-items-container');
      const emptyState = document.getElementById('cart-empty-state');
      const headerCount = document.getElementById('header-cart-count');
      const subtotalEl = document.getElementById('cart-subtotal');
      const proteinTally = document.getElementById('stash-protein-tally');
      const shippingBar = document.getElementById('shipping-bar-fill');
      const shippingText = document.getElementById('shipping-progress-text');
      const shippingPercent = document.getElementById('shipping-progress-percent');
      const subToggle = document.getElementById('sub-toggle');

      const totalCount = this.items.reduce((sum, i) => sum + i.qty, 0);
      let rawSubtotal = this.items.reduce((sum, i) => sum + i.price * i.qty, 0);
      const totalProtein = this.items.reduce((sum, i) => sum + (i.protein * i.qty), 0);

      if (subToggle && subToggle.checked) {
        rawSubtotal = rawSubtotal * 0.85;
      }

      if (headerCount) headerCount.textContent = totalCount;
      if (subtotalEl) subtotalEl.textContent = `$${rawSubtotal.toFixed(2)}`;
      if (proteinTally) proteinTally.textContent = `${totalProtein}g Protein`;

      // Free shipping threshold = $45
      const freeShippingThreshold = 45;
      const progress = Math.min(100, Math.round((rawSubtotal / freeShippingThreshold) * 100));
      if (shippingBar) shippingBar.style.width = `${progress}%`;
      if (shippingPercent) shippingPercent.textContent = `${progress}%`;
      
      if (shippingText) {
        if (rawSubtotal >= freeShippingThreshold) {
          shippingText.textContent = '🎉 YOU UNLOCKED FREE COLD SHIPPING!';
        } else {
          const needed = (freeShippingThreshold - rawSubtotal).toFixed(2);
          shippingText.textContent = `ADD $${needed} MORE FOR FREE COLD SHIPPING`;
        }
      }

      if (!container) return;

      if (this.items.length === 0) {
        container.innerHTML = `
          <div id="cart-empty-state" class="text-center py-12">
            <div class="text-5xl mb-3">📦</div>
            <div class="font-bubble text-xl font-black text-munches-navy">Your Stash is Empty</div>
            <p class="text-xs font-semibold text-munches-navy/70 mt-1">
              Pick a pack from the lineup to take the edge off.
            </p>
          </div>
        `;
        return;
      }

      container.innerHTML = this.items.map(item => `
        <div class="bg-munches-ivory border-2 border-munches-navy rounded-2xl p-3 flex items-center justify-between shadow-sm">
          <div>
            <div class="font-bubble text-base font-black text-munches-navy">${item.name}</div>
            <div class="text-[11px] font-black text-munches-orange">$${item.price.toFixed(2)} / pack</div>
          </div>
          <div class="flex items-center gap-2">
            <button onclick="window.MunchesCart.changeQty('${item.name}', -1)" class="w-6 h-6 rounded-lg bg-munches-cream border border-munches-navy font-black text-xs flex items-center justify-center shadow-sm">-</button>
            <span class="font-black text-xs w-4 text-center">${item.qty}</span>
            <button onclick="window.MunchesCart.changeQty('${item.name}', 1)" class="w-6 h-6 rounded-lg bg-munches-cream border border-munches-navy font-black text-xs flex items-center justify-center shadow-sm">+</button>
            <button onclick="window.MunchesCart.removeItem('${item.name}')" class="ml-2 text-xs font-bold text-red-500 hover:text-red-700">✕</button>
          </div>
        </div>
      `).join('');
    }
  };

  // Event Listeners for Cart Drawer
  document.getElementById('open-cart-btn')?.addEventListener('click', () => window.MunchesCart.open());
  document.getElementById('close-cart-btn')?.addEventListener('click', () => window.MunchesCart.close());
  document.getElementById('cart-drawer-overlay')?.addEventListener('click', (e) => {
    if (e.target.id === 'cart-drawer-overlay') window.MunchesCart.close();
  });
  document.getElementById('sub-toggle')?.addEventListener('change', () => window.MunchesCart.updateUI());

  // Hook up all "Add to Stash" buttons on page
  document.querySelectorAll('.btn-add-flavor').forEach(btn => {
    btn.addEventListener('click', () => {
      const flavor = btn.getAttribute('data-flavor') || 'Original Mozzarella';
      const price = btn.getAttribute('data-price') || '8.99';
      window.MunchesCart.addItem(flavor, price);
    });
  });

  // Hero order button opens cart or adds starter pack
  document.getElementById('hero-order-btn')?.addEventListener('click', () => {
    window.MunchesCart.addItem('The Weekly Habit (6 Packs)', 49.99, 252);
  });

  // Checkout button simulation
  document.getElementById('cart-checkout-btn')?.addEventListener('click', () => {
    if (window.MunchesCart.items.length === 0) {
      alert('Your stash is empty! Add a pack first.');
      return;
    }
    window.MunchesCart.close();
    const successModal = document.getElementById('checkout-success-modal');
    if (successModal) {
      successModal.classList.remove('hidden');
      successModal.classList.add('flex');
    }
    if (window.MunchesSound) window.MunchesSound.playBiteSound();
    if (typeof confetti === 'function') {
      confetti({
        particleCount: 120,
        spread: 100,
        origin: { y: 0.5 },
        colors: ['#FF521B', '#FFE042', '#2CA8E2', '#009B66']
      });
    }
  });

  document.getElementById('close-success-modal-btn')?.addEventListener('click', () => {
    const successModal = document.getElementById('checkout-success-modal');
    if (successModal) {
      successModal.classList.add('hidden');
      successModal.classList.remove('flex');
    }
    window.MunchesCart.items = [];
    window.MunchesCart.updateUI();
  });
</script>
