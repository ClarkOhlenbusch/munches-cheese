---
// CheatCodeComparison.astro
---

<section id="cheat-code" class="relative py-20 px-4 sm:px-6 md:px-8 bg-munches-orange text-munches-cream border-b-4 border-munches-navy">
  
  <div class="max-w-6xl mx-auto">
    
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-14">
      <div class="inline-block bg-munches-yellow text-munches-navy text-xs font-black tracking-widest uppercase px-3 py-1 rounded-full border-2 border-munches-navy shadow-pop-sm mb-3">
        THE NUTRITIONAL REVELATION
      </div>
      <h2 class="font-bubble text-4xl sm:text-5xl md:text-6xl font-black text-munches-cream tracking-tight text-shadow-pop">
        The Macro Cheat Code: By The Numbers.
      </h2>
      <p class="font-bold text-sm sm:text-base text-munches-cream/90 mt-3 max-w-xl mx-auto">
        Don't let $4 marketing campaigns fool you into eating candy bars masquerading as health food. 
        Compare Munches against standard snacking options:
      </p>
    </div>

    <!-- Comparison Table / Cards -->
    <div class="grid grid-cols-1 lg:grid-cols-4 gap-4 sm:gap-6 mb-12">
      
      <!-- Option 1: MUNCHES (Winner Card) -->
      <div class="lg:col-span-1 bg-munches-cream text-munches-navy border-4 border-munches-navy rounded-3xl p-5 shadow-pop-navy-lg relative transform lg:-translate-y-4 order-first">
        <div class="absolute -top-3.5 left-1/2 -translate-x-1/2 bg-munches-yellow border-2 border-munches-navy px-3 py-0.5 rounded-full text-[11px] font-black tracking-wider uppercase text-munches-navy shadow-sm">
          👑 THE CHEAT CODE
        </div>

        <div class="text-center pt-2 pb-4 border-b-2 border-munches-navy/20">
          <div class="text-3xl mb-1">🧀</div>
          <h3 class="font-bubble text-2xl font-black text-munches-orange">MUNCHES™</h3>
          <p class="text-xs font-black text-munches-navy/70 uppercase">Real Whole-Milk Mozzarella</p>
        </div>

        <div class="py-4 space-y-3 text-xs font-bold">
          <div class="flex justify-between items-center bg-munches-yellow/40 p-2 rounded-xl">
            <span>PROTEIN:</span>
            <span class="font-black text-munches-navy text-sm">7g per stick</span>
          </div>
          <div class="flex justify-between items-center p-2 rounded-xl">
            <span>CALORIES:</span>
            <span class="font-black text-munches-orange text-sm">80 cal</span>
          </div>
          <div class="flex justify-between items-center p-2 rounded-xl">
            <span>INGREDIENTS:</span>
            <span class="font-black text-munches-green text-sm">3 (Milk, Salt, Enzymes)</span>
          </div>
          <div class="flex justify-between items-center p-2 rounded-xl">
            <span>SUGAR ALCOHOLS:</span>
            <span class="font-black text-munches-green text-sm">0g (No Maltitol)</span>
          </div>
          <div class="flex justify-between items-center p-2 rounded-xl">
            <span>AVG COST:</span>
            <span class="font-black text-munches-navy text-sm">~$1.25 / stick</span>
          </div>
          <div class="flex justify-between items-center bg-munches-orange text-munches-cream p-2 rounded-xl font-black">
            <span>TASTE & PULL:</span>
            <span>10 / 10 Pure Joy</span>
          </div>
        </div>

        <div class="mt-2 text-center text-[10px] font-black uppercase text-munches-orange tracking-wider bg-munches-orange/10 py-1.5 rounded-xl">
          ✓ Certified Pocket Flip-Top
        </div>
      </div>

      <!-- Option 2: "Trendy Gym Protein Bar" -->
      <div class="bg-munches-cream/90 text-munches-navy border-3 border-munches-navy rounded-3xl p-5 shadow-pop-sm flex flex-col justify-between">
        <div>
          <div class="text-center pb-3 border-b-2 border-munches-navy/20">
            <div class="text-2xl mb-1">🍫</div>
            <h4 class="font-bubble text-xl font-black text-munches-navy">Chalky Protein Bar</h4>
            <p class="text-[11px] font-bold text-munches-navy/60 uppercase">The $4.50 Gym Candy</p>
          </div>

          <div class="py-3 space-y-2.5 text-xs font-semibold text-munches-navy/80">
            <div class="flex justify-between">
              <span>PROTEIN:</span>
              <span class="font-bold">20g</span>
            </div>
            <div class="flex justify-between text-red-600 font-bold">
              <span>CALORIES:</span>
              <span>240 - 280 cal</span>
            </div>
            <div class="flex justify-between text-red-600 font-bold">
              <span>INGREDIENTS:</span>
              <span>26+ laboratory additives</span>
            </div>
            <div class="flex justify-between text-red-600 font-bold">
              <span>SUGAR ALCOHOLS:</span>
              <span>18g (Bloat warning)</span>
            </div>
            <div class="flex justify-between">
              <span>AVG COST:</span>
              <span>$4.29 each</span>
            </div>
          </div>
        </div>

        <div class="bg-red-100 border border-red-300 p-2 rounded-xl text-center text-[10px] font-bold text-red-700">
          ⚠️ Tastes like sweetened sawdust
        </div>
      </div>

      <!-- Option 3: "Granola Bar" -->
      <div class="bg-munches-cream/90 text-munches-navy border-3 border-munches-navy rounded-3xl p-5 shadow-pop-sm flex flex-col justify-between">
        <div>
          <div class="text-center pb-3 border-b-2 border-munches-navy/20">
            <div class="text-2xl mb-1">🌾</div>
            <h4 class="font-bubble text-xl font-black text-munches-navy">Supermarket Granola</h4>
            <p class="text-[11px] font-bold text-munches-navy/60 uppercase">Basically a Cookie</p>
          </div>

          <div class="py-3 space-y-2.5 text-xs font-semibold text-munches-navy/80">
            <div class="flex justify-between text-red-600 font-bold">
              <span>PROTEIN:</span>
              <span>1g - 2g</span>
            </div>
            <div class="flex justify-between">
              <span>CALORIES:</span>
              <span>190 cal</span>
            </div>
            <div class="flex justify-between text-red-600 font-bold">
              <span>ADDED SUGAR:</span>
              <span>16g Corn Syrup</span>
            </div>
            <div class="flex justify-between text-red-600 font-bold">
              <span>OILS:</span>
              <span>Canola & Palm oil</span>
            </div>
            <div class="flex justify-between">
              <span>AVG COST:</span>
              <span>$1.85 each</span>
            </div>
          </div>
        </div>

        <div class="bg-yellow-100 border border-yellow-300 p-2 rounded-xl text-center text-[10px] font-bold text-yellow-800">
          ⚠️ Blood sugar spike in 15 mins
        </div>
      </div>

      <!-- Option 4: "Vending Machine Chips" -->
      <div class="bg-munches-cream/90 text-munches-navy border-3 border-munches-navy rounded-3xl p-5 shadow-pop-sm flex flex-col justify-between">
        <div>
          <div class="text-center pb-3 border-b-2 border-munches-navy/20">
            <div class="text-2xl mb-1">🥨</div>
            <h4 class="font-bubble text-xl font-black text-munches-navy">Vending Machine Chips</h4>
            <p class="text-[11px] font-bold text-munches-navy/60 uppercase">The 3 PM Desperation</p>
          </div>

          <div class="py-3 space-y-2.5 text-xs font-semibold text-munches-navy/80">
            <div class="flex justify-between text-red-600 font-bold">
              <span>PROTEIN:</span>
              <span>2g</span>
            </div>
            <div class="flex justify-between text-red-600 font-bold">
              <span>CALORIES:</span>
              <span>260 cal</span>
            </div>
            <div class="flex justify-between text-red-600 font-bold">
              <span>NUTRITION:</span>
              <span>Virtually 0% micronutrients</span>
            </div>
            <div class="flex justify-between">
              <span>SATIETY:</span>
              <span>Hungry again in 20 min</span>
            </div>
            <div class="flex justify-between">
              <span>AVG COST:</span>
              <span>$2.25 bag</span>
            </div>
          </div>
        </div>

        <div class="bg-red-100 border border-red-300 p-2 rounded-xl text-center text-[10px] font-bold text-red-700">
          ⚠️ Greasy fingers on the keyboard
        </div>
      </div>

    </div>

    <!-- Interactive Macro Savings Calculator -->
    <div class="bg-munches-cream text-munches-navy border-4 border-munches-navy rounded-3xl p-6 sm:p-8 shadow-pop-navy max-w-3xl mx-auto">
      <div class="flex flex-col md:flex-row items-center justify-between gap-6">
        
        <div class="w-full md:w-1/2 text-left">
          <span class="text-xs font-black uppercase tracking-wider text-munches-orange">
            INTERACTIVE CALCULATOR
          </span>
          <h3 class="font-bubble text-2xl sm:text-3xl font-black text-munches-navy mt-1 mb-2">
            Calculate Your Cheat Code Savings
          </h3>
          <p class="text-xs font-semibold text-munches-navy/80 mb-4">
            How many snacks do you crush per week? See how much money & junk ingredients you eliminate:
          </p>

          <!-- Slider -->
          <div class="space-y-2">
            <div class="flex justify-between text-xs font-black">
              <span>Weekly Snack Breaks:</span>
              <span id="slider-val" class="text-munches-orange text-sm font-black">5 sticks/week</span>
            </div>
            <input 
              id="snack-slider"
              type="range" 
              min="1" 
              max="20" 
              value="5" 
              class="w-full h-3 bg-munches-navy/20 rounded-lg appearance-none cursor-pointer accent-munches-orange"
            />
            <div class="flex justify-between text-[10px] font-bold text-munches-navy/60">
              <span>1 (Casual)</span>
              <span>10 (Daily Habit)</span>
              <span>20 (Cheese Fiend)</span>
            </div>
          </div>
        </div>

        <!-- Output Metric Card -->
        <div class="w-full md:w-1/2 bg-munches-yellow border-3 border-munches-navy rounded-2xl p-4 text-center shadow-pop-sm">
          <div class="text-xs font-black uppercase text-munches-navy tracking-wider">
            YOUR ANNUAL CHEAT CODE STATS:
          </div>
          <div class="grid grid-cols-2 gap-3 mt-3">
            <div class="bg-munches-cream p-2.5 rounded-xl border border-munches-navy">
              <div id="calc-money-saved" class="font-bubble text-2xl font-black text-munches-orange">
                $780
              </div>
              <div class="text-[10px] font-black uppercase text-munches-navy/70">
                Saved vs Protein Bars
              </div>
            </div>

            <div class="bg-munches-cream p-2.5 rounded-xl border border-munches-navy">
              <div id="calc-protein-gained" class="font-bubble text-2xl font-black text-munches-green">
                1,820g
              </div>
              <div class="text-[10px] font-black uppercase text-munches-navy/70">
                Pure Dairy Protein
              </div>
            </div>
          </div>

          <div class="mt-3 text-[11px] font-bold text-munches-navy">
            🎉 Eliminated: <span id="calc-chemicals" class="font-black text-munches-orange">4,680g</span> of synthetic fillers & maltitol!
          </div>
        </div>

      </div>
    </div>

  </div>
</section>

<script is:inline>
  const slider = document.getElementById('snack-slider');
  const sliderVal = document.getElementById('slider-val');
  const calcMoney = document.getElementById('calc-money-saved');
  const calcProtein = document.getElementById('calc-protein-gained');
  const calcChemicals = document.getElementById('calc-chemicals');

  if (slider && sliderVal && calcMoney && calcProtein && calcChemicals) {
    slider.addEventListener('input', (e) => {
      const sticks = parseInt(e.target.value);
      sliderVal.textContent = `${sticks} sticks/week`;

      // Calculation:
      // Protein bar cost: ~$4.25 vs Munches ~$1.25 -> $3 saved per snack * sticks * 52 weeks
      const savedAnnual = Math.round(sticks * 3.00 * 52);
      // Protein gained: 7g * sticks * 52
      const proteinAnnual = sticks * 7 * 52;
      // Synthetic fillers eliminated: ~18g per bar avoided * sticks * 52
      const chemicalsAvoided = sticks * 18 * 52;

      calcMoney.textContent = `$${savedAnnual.toLocaleString()}`;
      calcProtein.textContent = `${proteinAnnual.toLocaleString()}g`;
      calcChemicals.textContent = `${chemicalsAvoided.toLocaleString()}g`;

      if (window.MunchesSound && sticks % 3 === 0) {
        window.MunchesSound.playStickPull();
      }
    });
  }
</script>
