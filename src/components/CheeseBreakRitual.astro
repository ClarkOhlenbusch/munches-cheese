---
// CheeseBreakRitual.astro
---

<section class="relative py-20 px-4 sm:px-6 md:px-8 bg-munches-yellow border-b-4 border-munches-navy text-munches-navy">
  
  <div class="max-w-5xl mx-auto">
    
    <div class="text-center max-w-2xl mx-auto mb-12">
      <span class="bg-munches-navy text-munches-yellow text-xs font-black px-3 py-1 rounded-full border border-munches-navy uppercase">
        THE 3:00 PM RITUAL
      </span>
      <h2 class="font-bubble text-4xl sm:text-5xl font-black text-munches-navy tracking-tight mt-2">
        The 4-Step Cheese Break.
      </h2>
      <p class="font-bold text-sm sm:text-base text-munches-navy/80 mt-2">
        Step away from your monitor. Don't touch that vape. Crack a pack of Munches instead.
      </p>
    </div>

    <!-- Interactive 4-Step Station -->
    <div class="bg-munches-cream border-4 border-munches-navy rounded-3xl p-6 sm:p-10 shadow-pop-navy-lg">
      
      <!-- Progress Track -->
      <div class="flex items-center justify-between mb-8 max-w-xl mx-auto relative">
        <div class="absolute left-0 right-0 top-1/2 -translate-y-1/2 h-2 bg-munches-navy/20 rounded-full -z-0"></div>
        <div id="ritual-progress-bar" class="absolute left-0 top-1/2 -translate-y-1/2 h-2 bg-munches-orange rounded-full -z-0 transition-all duration-300 w-1/4"></div>

        <button class="step-btn relative z-10 w-10 h-10 rounded-full border-3 border-munches-navy bg-munches-orange text-munches-cream font-bubble font-black text-sm flex items-center justify-center shadow-sm" data-step="1">1</button>
        <button class="step-btn relative z-10 w-10 h-10 rounded-full border-3 border-munches-navy bg-munches-cream text-munches-navy font-bubble font-black text-sm flex items-center justify-center shadow-sm" data-step="2">2</button>
        <button class="step-btn relative z-10 w-10 h-10 rounded-full border-3 border-munches-navy bg-munches-cream text-munches-navy font-bubble font-black text-sm flex items-center justify-center shadow-sm" data-step="3">3</button>
        <button class="step-btn relative z-10 w-10 h-10 rounded-full border-3 border-munches-navy bg-munches-cream text-munches-navy font-bubble font-black text-sm flex items-center justify-center shadow-sm" data-step="4">4</button>
      </div>

      <!-- Step Content Display -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 items-center">
        
        <!-- Left: Ritual Animation Preview -->
        <div class="bg-munches-sky rounded-2xl border-3 border-munches-navy p-8 flex flex-col items-center justify-center min-h-[260px] text-center shadow-inner relative overflow-hidden">
          
          <div id="ritual-icon-display" class="text-7xl mb-3 transition-transform duration-300 transform scale-100">
            📦
          </div>
          
          <div id="ritual-status-badge" class="bg-munches-cream text-munches-navy px-3 py-1 rounded-full text-xs font-black uppercase border border-munches-navy shadow-sm">
            STEP 1: FLICK THE TOP OPEN
          </div>

          <div id="ritual-sfx-hint" class="text-[11px] font-bold text-munches-cream mt-2">
            *CLICK-SNAP!* Satisfying hinge action
          </div>
        </div>

        <!-- Right: Step Narrative & Action Button -->
        <div class="flex flex-col justify-between">
          <div>
            <div id="ritual-step-tag" class="text-xs font-black uppercase tracking-wider text-munches-orange mb-1">
              STEP 01 OF 04
            </div>
            <h3 id="ritual-step-title" class="font-bubble text-2xl sm:text-3xl font-black text-munches-navy mb-3">
              Flick The Flip-Top Open
            </h3>
            <p id="ritual-step-desc" class="text-sm font-semibold text-munches-navy/80 leading-relaxed mb-6">
              Hear that crisp cardboard pop? That's the opening bell of your afternoon sanity. Gaze upon the golden orange lid that reads "GOOD SNACKS, BRIGHTER DAYS ◡".
            </p>
          </div>

          <button 
            id="ritual-action-btn"
            class="btn-tactile bg-munches-orange text-munches-cream py-3.5 px-6 rounded-2xl font-bubble text-lg border-3 border-munches-navy shadow-pop-navy flex items-center justify-center gap-3 w-full"
          >
            <span>TAP TO FLIP LID</span>
            <span>⚡</span>
          </button>
        </div>

      </div>

    </div>

  </div>
</section>

<script is:inline>
  const steps = [
    {
      num: 1,
      icon: '📦',
      badge: 'STEP 1: FLICK THE TOP OPEN',
      sfx: '*CLICK-SNAP!* Satisfying hinge action',
      tag: 'STEP 01 OF 04',
      title: 'Flick The Flip-Top Open',
      desc: 'Hear that crisp cardboard pop? That\'s the opening bell of your afternoon sanity. Gaze upon the golden orange lid that reads "GOOD SNACKS, BRIGHTER DAYS ◡".',
      btnText: 'TAP TO FLIP LID ⚡',
      action: 'flip'
    },
    {
      num: 2,
      icon: '🧀',
      badge: 'STEP 2: SLIDE OUT A STICK',
      sfx: '*SHHH-WHIP!* Smooth friction pull',
      tag: 'STEP 02 OF 04',
      title: 'Slide Out The Stick',
      desc: 'Draw one of the 6 individually sealed mozzarella sticks. Sturdy, cold from the fridge, perfectly portioned for maximum dopamine.',
      btnText: 'TAP TO DRAW STICK ⬆️',
      action: 'pull'
    },
    {
      num: 3,
      icon: '✂️',
      badge: 'STEP 3: PEEL THE SEAL',
      sfx: '*CRINKLE-ZIP!* Effortless vacuum seal release',
      tag: 'STEP 03 OF 04',
      title: 'Peel The Notch',
      desc: 'Follow the wrapper motto: PEEL. SNACK. REPEAT. ◡ The clear plastic folds away smoothly without tearing or leaving sticky residue.',
      btnText: 'TAP TO PEEL WRAPPER ✨',
      action: 'peel'
    },
    {
      num: 4,
      icon: '🤤',
      badge: 'STEP 4: STRING & TAKE THE EDGE OFF',
      sfx: '*CRUNCH-PULL!* Pure dairy bliss',
      tag: 'STEP 04 OF 04',
      title: 'String The Cheese & Take The Edge Off',
      desc: 'Pull those savory whole-milk fibers. Feel 7 grams of pure protein and zero sugar recharge your brain. Edge successfully eliminated.',
      btnText: 'TAKE THE EDGE OFF 🎉',
      action: 'bite'
    }
  ];

  let currentStep = 1;

  const iconDisplay = document.getElementById('ritual-icon-display');
  const badgeDisplay = document.getElementById('ritual-status-badge');
  const sfxHint = document.getElementById('ritual-sfx-hint');
  const stepTag = document.getElementById('ritual-step-tag');
  const stepTitle = document.getElementById('ritual-step-title');
  const stepDesc = document.getElementById('ritual-step-desc');
  const actionBtn = document.getElementById('ritual-action-btn');
  const progressBar = document.getElementById('ritual-progress-bar');
  const stepBtns = document.querySelectorAll('.step-btn');

  function renderStep(stepIndex) {
    const data = steps[stepIndex - 1];
    currentStep = stepIndex;

    // Update progress bar
    progressBar.style.width = `${(stepIndex / 4) * 100}%`;

    // Update step dots
    stepBtns.forEach((btn, idx) => {
      if (idx + 1 <= stepIndex) {
        btn.classList.remove('bg-munches-cream', 'text-munches-navy');
        btn.classList.add('bg-munches-orange', 'text-munches-cream');
      } else {
        btn.classList.add('bg-munches-cream', 'text-munches-navy');
        btn.classList.remove('bg-munches-orange', 'text-munches-cream');
      }
    });

    // Animate display
    iconDisplay.classList.add('scale-75');
    setTimeout(() => {
      iconDisplay.textContent = data.icon;
      badgeDisplay.textContent = data.badge;
      sfxHint.textContent = data.sfx;
      stepTag.textContent = data.tag;
      stepTitle.textContent = data.title;
      stepDesc.textContent = data.desc;
      actionBtn.innerHTML = `<span>${data.btnText}</span>`;
      iconDisplay.classList.remove('scale-75');
    }, 150);

    // Audio SFX
    if (window.MunchesSound) {
      if (data.action === 'flip') window.MunchesSound.playFlipPack();
      else if (data.action === 'pull') window.MunchesSound.playStickPull();
      else if (data.action === 'peel') window.MunchesSound.playPeelSound();
      else if (data.action === 'bite') {
        window.MunchesSound.playBiteSound();
        if (typeof confetti === 'function') {
          confetti({
            particleCount: 60,
            spread: 60,
            origin: { y: 0.7 },
            colors: ['#FF521B', '#FFE042', '#009B66']
          });
        }
      }
    }
  }

  if (actionBtn) {
    actionBtn.addEventListener('click', () => {
      const nextStep = currentStep >= 4 ? 1 : currentStep + 1;
      renderStep(nextStep);
    });
  }

  stepBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      const step = parseInt(btn.getAttribute('data-step') || '1');
      renderStep(step);
    });
  });
</script>
