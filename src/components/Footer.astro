---
// Footer.astro
---

<footer class="bg-munches-navy text-munches-cream pt-16 pb-12 px-4 sm:px-6 md:px-8 border-t-4 border-munches-navy relative overflow-hidden">
  
  <div class="max-w-7xl mx-auto">
    
    <!-- Top Newsletter & Drop Alert Banner -->
    <div class="bg-munches-orange border-4 border-munches-navy rounded-3xl p-6 sm:p-8 shadow-pop-navy-lg mb-16 flex flex-col md:flex-row items-center justify-between gap-6">
      <div class="text-left max-w-xl">
        <span class="bg-munches-yellow text-munches-navy text-[10px] font-black px-2.5 py-1 rounded-full border border-munches-navy uppercase">
          LIMITED PACK DROPS
        </span>
        <h3 class="font-bubble text-3xl sm:text-4xl font-black text-munches-cream mt-2">
          Never Run Out of Sticks.
        </h3>
        <p class="text-xs sm:text-sm font-bold text-munches-cream/90 mt-1">
          Get notified when seasonal flavor cartons drop (Truffle Mozzarella & Smoked Habanero) + get 15% off your first stash.
        </p>
      </div>

      <div class="w-full md:w-auto flex flex-col sm:flex-row gap-2">
        <input 
          type="email" 
          placeholder="Enter your work or personal email..." 
          class="px-4 py-3 rounded-2xl bg-munches-cream text-munches-navy placeholder:text-munches-navy/50 font-bold text-xs border-2 border-munches-navy outline-none focus:ring-2 focus:ring-munches-yellow min-w-[260px]"
        />
        <button class="btn-tactile bg-munches-yellow text-munches-navy px-6 py-3 rounded-2xl font-bubble text-base border-2 border-munches-navy shadow-pop-sm whitespace-nowrap">
          JOIN THE HABIT
        </button>
      </div>
    </div>

    <!-- Main Footer Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-8 mb-12">
      
      <!-- Brand Summary -->
      <div class="lg:col-span-2">
        <div class="flex items-center gap-2 mb-3">
          <span class="font-bubble text-3xl font-black text-munches-cream">MUNCHES™</span>
          <span class="bg-munches-yellow text-munches-navy text-[9px] font-black px-2 py-0.5 rounded-full border border-munches-navy">
            EST. 2026
          </span>
        </div>
        <p class="text-xs font-semibold text-munches-cream/80 max-w-sm leading-relaxed mb-4">
          The high-protein cheese stick cheat code. Born from Costco aisle math and a viral TikTok joke. Crafted with 100% whole milk cheese and packaged in a pocket-sized flip-top carton.
        </p>
        <div class="text-xs font-bold text-munches-yellow">
          "Just a little something to take the edge off."
        </div>
      </div>

      <!-- Quick Nav -->
      <div>
        <div class="font-bubble text-sm font-black text-munches-yellow uppercase tracking-wider mb-3">
          The Lineup
        </div>
        <ul class="space-y-2 text-xs font-bold text-munches-cream/80">
          <li><a href="#flavors" class="hover:text-munches-yellow transition-colors">Original Mozzarella</a></li>
          <li><a href="#flavors" class="hover:text-munches-yellow transition-colors">Smoked Gouda</a></li>
          <li><a href="#flavors" class="hover:text-munches-yellow transition-colors">Spicy Pepper Jack</a></li>
          <li><a href="#flavors" class="hover:text-munches-yellow transition-colors">Wisconsin Sharp Cheddar</a></li>
          <li><a href="#flavors" class="hover:text-munches-yellow transition-colors">The Executive Carton</a></li>
        </ul>
      </div>

      <!-- Story & Lore -->
      <div>
        <div class="font-bubble text-sm font-black text-munches-yellow uppercase tracking-wider mb-3">
          The Lore
        </div>
        <ul class="space-y-2 text-xs font-bold text-munches-cream/80">
          <li><a href="#origin" class="hover:text-munches-yellow transition-colors">The Costco Revelation</a></li>
          <li><a href="#origin" class="hover:text-munches-yellow transition-colors">The TikTok Origin</a></li>
          <li><a href="#cheat-code" class="hover:text-munches-yellow transition-colors">The Macro Cheat Code</a></li>
          <li><a href="#pack-experience" class="hover:text-munches-yellow transition-colors">Flip-Top Anatomy</a></li>
          <li><a href="#cheat-code" class="hover:text-munches-yellow transition-colors">Macro Calculator</a></li>
        </ul>
      </div>

      <!-- Official Packaging Warning -->
      <div>
        <div class="font-bubble text-sm font-black text-munches-yellow uppercase tracking-wider mb-3">
          Advisory
        </div>
        <div class="bg-white/10 border border-white/20 p-3 rounded-xl text-[10px] text-munches-cream/90 font-bold leading-tight">
          <strong>WARNING:</strong> Munches contains real food. No soy lecithin, zero maltitol, no chalky aftertaste. Side effects include coworkers asking to bum a stick.
        </div>
      </div>

    </div>

    <!-- Bottom Copyright & Disclaimer -->
    <div class="border-t border-white/10 pt-6 flex flex-col sm:flex-row items-center justify-between text-[11px] font-bold text-munches-cream/60 gap-4">
      <div>
        © 2026 MUNCHES CHEESE CO. ALL RIGHTS RESERVED. KEEP REFRIGERATED.
      </div>
      <div class="flex gap-4">
        <a href="#hero" class="hover:text-white">BACK TO TOP ▲</a>
        <span>•</span>
        <a href="#" class="hover:text-white">PRIVACY</a>
        <span>•</span>
        <a href="#" class="hover:text-white">TERMS</a>
      </div>
    </div>

  </div>
</footer>
