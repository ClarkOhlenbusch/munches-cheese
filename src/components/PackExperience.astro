---
// PackExperience.astro
---

<section id="pack-experience" class="relative py-20 px-4 sm:px-6 md:px-8 bg-munches-cream text-munches-navy border-b-4 border-munches-navy">
  
  <div class="max-w-6xl mx-auto">
    
    <!-- Section Header -->
    <div class="text-center max-w-2xl mx-auto mb-16">
      <div class="inline-block bg-munches-orange text-munches-cream text-xs font-black tracking-widest uppercase px-3 py-1 rounded-full border-2 border-munches-navy shadow-pop-sm mb-3">
        THE HARDWARE
      </div>
      <h2 class="font-bubble text-4xl sm:text-5xl md:text-6xl font-black text-munches-navy tracking-tight">
        Anatomy of the Flip-Top Pack.
      </h2>
      <p class="font-bold text-sm sm:text-base text-munches-navy/80 mt-2">
        Why should bad habits have all the satisfying packaging? We brought the ritual back for the good guys.
      </p>
    </div>

    <!-- The Anatomy Visualizer & Feature Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
      
      <!-- Left Features -->
      <div class="lg:col-span-4 space-y-6">
        
        <!-- Feature 1 -->
        <div class="bg-munches-ivory border-3 border-munches-navy rounded-2xl p-4 shadow-pop-sm group hover:-translate-x-1 transition-transform">
          <div class="flex items-center gap-3 mb-2">
            <span class="w-8 h-8 rounded-full bg-munches-yellow border-2 border-munches-navy flex items-center justify-center font-black text-xs">
              01
            </span>
            <h4 class="font-bubble text-lg font-black text-munches-navy">Top-Hinged Flip Lid</h4>
          </div>
          <p class="text-xs font-semibold text-munches-navy/80 leading-snug">
            Snaps open with a single flick of your thumb. Gives you that unmistakable, satisfying tactile click.
          </p>
        </div>

        <!-- Feature 2 -->
        <div class="bg-munches-ivory border-3 border-munches-navy rounded-2xl p-4 shadow-pop-sm group hover:-translate-x-1 transition-transform">
          <div class="flex items-center gap-3 mb-2">
            <span class="w-8 h-8 rounded-full bg-munches-orange text-munches-cream border-2 border-munches-navy flex items-center justify-center font-black text-xs">
              02
            </span>
            <h4 class="font-bubble text-lg font-black text-munches-navy">Inside-Lid Mantra</h4>
          </div>
          <p class="text-xs font-semibold text-munches-navy/80 leading-snug">
            Reveals our daily reminder: <strong class="text-munches-orange">GOOD SNACKS • BRIGHTER DAYS ◡</strong> stamped in bold uppercase.
          </p>
        </div>

        <!-- Feature 3 -->
        <div class="bg-munches-ivory border-3 border-munches-navy rounded-2xl p-4 shadow-pop-sm group hover:-translate-x-1 transition-transform">
          <div class="flex items-center gap-3 mb-2">
            <span class="w-8 h-8 rounded-full bg-munches-green text-white border-2 border-munches-navy flex items-center justify-center font-black text-xs">
              03
            </span>
            <h4 class="font-bubble text-lg font-black text-munches-navy">Individual Vacuum Sleeves</h4>
          </div>
          <p class="text-xs font-semibold text-munches-navy/80 leading-snug">
            Each stick is hermetically sealed with serrated peel notches: <strong class="text-munches-navy">PEEL. SNACK. REPEAT. ◡</strong>
          </p>
        </div>

      </div>

      <!-- Center Feature Pack Visual & Graphic Callouts -->
      <div class="lg:col-span-4 flex flex-col items-center justify-center relative">
        <div class="w-full max-w-[280px] bg-[#FF521B] rounded-3xl border-4 border-munches-navy p-4 shadow-pop-navy-lg flex flex-col justify-between text-center relative overflow-hidden">
          
          <!-- Cream Top Wave of Box -->
          <div class="absolute top-0 left-0 right-0 h-32 bg-munches-cream rounded-b-[40px] border-b-4 border-munches-navy"></div>

          <!-- Flip Top Lid Simulation -->
          <div class="relative z-10 pt-2 pb-6 border-b-2 border-dashed border-munches-navy/40">
            <span class="text-[9px] font-black uppercase tracking-widest text-munches-navy bg-munches-yellow px-2 py-0.5 rounded-full border border-munches-navy">
              PATENT-PENDING SNACK CARTON
            </span>
            <div class="font-bubble text-4xl font-black text-munches-cream drop-shadow-[0_2px_0_#FF521B] text-stroke-navy mt-2">
              MUNCHES
            </div>
            <div class="text-[10px] font-black text-munches-navy uppercase tracking-wider">
              ORIGINAL MOZZARELLA
            </div>
          </div>

          <!-- Inside view showing sticks -->
          <div class="relative z-10 py-6 flex items-center justify-center gap-2">
            <div class="w-8 h-28 bg-[#FFF7E8] rounded-full border-2 border-munches-navy flex flex-col items-center justify-center shadow-sm">
              <span class="text-[7px] font-black text-munches-navy -rotate-90">PEEL ◡</span>
            </div>
            <div class="w-8 h-32 bg-white rounded-full border-2 border-munches-navy flex flex-col items-center justify-center shadow-md transform -translate-y-2">
              <span class="text-[8px] font-black text-munches-orange -rotate-90 font-bubble">MUNCHES</span>
            </div>
            <div class="w-8 h-28 bg-[#FFF7E8] rounded-full border-2 border-munches-navy flex flex-col items-center justify-center shadow-sm">
              <span class="text-[7px] font-black text-munches-navy -rotate-90">PEEL ◡</span>
            </div>
          </div>

          <!-- Lower Front Box Info -->
          <div class="relative z-10 pt-4 border-t-2 border-munches-cream/30 flex justify-between items-center text-[9px] font-black text-white uppercase">
            <span>6 STICKS</span>
            <span class="bg-munches-yellow text-munches-navy px-1.5 py-0.5 rounded">7G PRO</span>
            <span>80 CAL</span>
          </div>

        </div>

        <span class="text-xs font-black uppercase text-munches-navy/70 mt-3">
          Dimensions: 4.8" x 3.2" x 1.1" (Pocket Sized)
        </span>
      </div>

      <!-- Right Features -->
      <div class="lg:col-span-4 space-y-6">
        
        <!-- Feature 4 -->
        <div class="bg-munches-ivory border-3 border-munches-navy rounded-2xl p-4 shadow-pop-sm group hover:translate-x-1 transition-transform">
          <div class="flex items-center gap-3 mb-2">
            <span class="w-8 h-8 rounded-full bg-munches-yellow border-2 border-munches-navy flex items-center justify-center font-black text-xs">
              04
            </span>
            <h4 class="font-bubble text-lg font-black text-munches-navy">The Side Spine Callout</h4>
          </div>
          <p class="text-xs font-semibold text-munches-navy/80 leading-snug">
            Embossed down the side: <strong class="text-munches-navy">CHEESE STICKS FOR A BRIGHTER YOU :) SNACK BETTER OFTEN</strong>.
          </p>
        </div>

        <!-- Feature 5 -->
        <div class="bg-munches-ivory border-3 border-munches-navy rounded-2xl p-4 shadow-pop-sm group hover:translate-x-1 transition-transform">
          <div class="flex items-center gap-3 mb-2">
            <span class="w-8 h-8 rounded-full bg-munches-orange text-munches-cream border-2 border-munches-navy flex items-center justify-center font-black text-xs">
              05
            </span>
            <h4 class="font-bubble text-lg font-black text-munches-navy">Pocket & Cup-Holder Fit</h4>
          </div>
          <p class="text-xs font-semibold text-munches-navy/80 leading-snug">
            Engineered to slide into denim back pockets, blazer inners, and car console slots without crushing.
          </p>
        </div>

        <!-- Feature 6 -->
        <div class="bg-munches-ivory border-3 border-munches-navy rounded-2xl p-4 shadow-pop-sm group hover:translate-x-1 transition-transform">
          <div class="flex items-center gap-3 mb-2">
            <span class="w-8 h-8 rounded-full bg-munches-sky text-white border-2 border-munches-navy flex items-center justify-center font-black text-xs">
              06
            </span>
            <h4 class="font-bubble text-lg font-black text-munches-navy">The Cool Mascot</h4>
          </div>
          <p class="text-xs font-semibold text-munches-navy/80 leading-snug">
            Our sunglasses-sporting cheese stick embodies the motto: <strong class="text-munches-navy">SMALL SNACKS, BIGGER DAYS</strong>.
          </p>
        </div>

      </div>

    </div>

  </div>
</section>
