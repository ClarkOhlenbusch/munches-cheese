---
// src/components/SiteFooter.astro
// Official Munches Brand Footer
---

<footer class="relative w-full bg-[#0B62C4] text-white pt-16 pb-12 px-4 sm:px-8 border-t-4 border-[#0B62C4] select-none">
  <div class="max-w-6xl mx-auto flex flex-col">
    
    <!-- Top Row: Big Brand & Newsletter -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 pb-12 border-b-2 border-white/20">
      
      <!-- Brand & Motto -->
      <div class="lg:col-span-6 flex flex-col items-start">
        <div class="flex items-center gap-2.5 bg-[#FFFDF5] border-3 border-[#FFE042] px-5 py-2 rounded-full shadow-[4px_4px_0px_#FFE042] mb-4">
          <span class="text-2xl leading-none">🧀</span>
          <span class="font-bubble text-xl sm:text-2xl font-black text-[#FA4616] tracking-wider">MUNCHES™</span>
        </div>
        <p class="font-bubble text-2xl sm:text-3xl font-black text-[#FFE042] leading-snug max-w-md">
          “A little something to take the edge off”
        </p>
        <p class="text-xs sm:text-sm text-white/80 font-bold mt-2 max-w-sm leading-relaxed">
          100% Wisconsin whole-milk mozzarella cheese sticks in a rigid flip-top pocket carton. Cheese sticks for a brighter you.
        </p>
      </div>

      <!-- Quick Section Links -->
      <div class="lg:col-span-3 flex flex-col gap-2.5 text-xs sm:text-sm font-black uppercase tracking-wider">
        <span class="text-[#FFE042] mb-1">EXPLORE</span>
        <a href="#hero" class="hover:text-[#FFE042] transition-colors">✦ The Hero</a>
        <a href="#the-pack" class="hover:text-[#FFE042] transition-colors">✦ The Pocket Carton</a>
        <a href="#macros" class="hover:text-[#FFE042] transition-colors">✦ Macro Cheat Code</a>
        <a href="#the-snack" class="hover:text-[#FFE042] transition-colors">✦ The Snack</a>
        <a href="#find-stores" class="hover:text-[#FFE042] transition-colors">✦ Store Demand</a>
      </div>

      <!-- Newsletter Sign Up -->
      <div class="lg:col-span-3 flex flex-col">
        <span class="text-xs font-black uppercase tracking-wider text-[#FFE042] mb-1">STAY SHARP</span>
        <p class="text-xs text-white/80 font-bold mb-3 leading-relaxed">
          Sign up for fresh snack drops, secret flavor voting, and store restock alerts.
        </p>
        <form id="footer-newsletter-form" class="flex items-center gap-2">
          <input 
            id="footer-email-input"
            type="email" 
            required
            placeholder="Your email address" 
            class="flex-1 bg-white/10 border-2 border-white/30 rounded-xl px-3 py-2 text-xs font-bold text-white placeholder-white/50 outline-none focus:border-[#FFE042]"
          />
          <button type="submit" class="btn-tactile bg-[#FFE042] text-[#0B62C4] font-bubble text-xs px-4 py-2 rounded-xl font-black border-2 border-[#0B62C4] hover:scale-105 active:scale-95 cursor-pointer whitespace-nowrap">
            JOIN
          </button>
        </form>
        <p id="footer-toast" class="hidden text-[11px] font-black text-[#FFE042] mt-2">
          🎉 You're on the list for Batch 001!
        </p>
      </div>

    </div>

    <!-- Bottom Row: Copyright & Wisconsin Badge -->
    <div class="pt-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs font-bold text-white/70">
      <div>
        © {new Date().getFullYear()} MUNCHES CHEESE CO. ALL RIGHTS RESERVED.
      </div>
      <div class="flex items-center gap-2 text-white font-black">
        <span>🧀</span>
        <span>CRAFTED IN WISCONSIN • REAL MOZZARELLA</span>
      </div>
    </div>

  </div>
</footer>

<script is:inline>
  (function() {
    const footerForm = document.getElementById('footer-newsletter-form');
    const footerInput = document.getElementById('footer-email-input');
    const footerToast = document.getElementById('footer-toast');

    if (footerForm) {
      footerForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        const email = (footerInput?.value || '').trim();
        if (!email || !email.includes('@')) return;

        try {
          await fetch('/api/waitlist', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              type: 'waitlist',
              email,
              name: 'Newsletter Subscriber',
              zip: 'USA',
              store: 'Costco Wholesale',
              flavor: 'Spicy Jalapeño 🌶️'
            })
          });

          if (footerToast) {
            footerToast.classList.remove('hidden');
            setTimeout(() => footerToast.classList.add('hidden'), 5000);
          }
          footerForm.reset();
        } catch (err) {
          console.error('Footer submission error:', err);
        }
      });
    }
  })();
</script>
