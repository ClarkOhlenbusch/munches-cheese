---
// src/components/StoreLocatorSection.astro
// Where to find Munches in stores
---

<section id="find-stores" class="relative w-full bg-[#FFE042] py-16 sm:py-24 px-4 sm:px-8 overflow-hidden border-b-4 border-[#0B62C4]">
  
  <div class="relative z-10 max-w-5xl mx-auto flex flex-col items-center text-center">
    
    <h2 class="reveal-on-scroll font-bubble text-3xl sm:text-5xl md:text-6xl font-black text-[#0B62C4] leading-[1.05] tracking-tight max-w-3xl">
      WHERE TO GRAB MUNCHES
    </h2>

    <p class="reveal-on-scroll font-bold text-sm sm:text-base md:text-lg text-[#0B62C4]/80 max-w-xl mt-4 leading-relaxed">
      Look for the bright orange flip-top carton in the dairy aisle right next to your favorite whole-milk cheeses.
    </p>

    <!-- Zip Code Search Box -->
    <div class="reveal-scale w-full max-w-md bg-white border-4 border-[#0B62C4] rounded-3xl p-2.5 shadow-[6px_6px_0px_#0B62C4] flex items-center gap-2 mt-8">
      <input 
        id="store-zip-input"
        type="text" 
        placeholder="Enter your ZIP code (e.g. 90210)" 
        class="flex-1 px-4 py-2 font-bold text-sm sm:text-base text-[#0B62C4] placeholder-[#0B62C4]/40 outline-none bg-transparent"
        maxlength="10"
      />
      <button 
        id="store-search-btn"
        class="btn-tactile bg-[#FA4616] text-white font-bubble text-xs sm:text-sm px-5 py-3 rounded-2xl border-2 border-[#0B62C4] shadow-[2px_2px_0px_#0B62C4] hover:bg-[#E03A09] active:scale-95 whitespace-nowrap cursor-pointer"
      >
        FIND STORES ➔
      </button>
    </div>

    <!-- Live Search Feedback Mock -->
    <div id="store-result-box" class="mt-4 hidden bg-white border-3 border-[#0B62C4] px-5 py-3 rounded-2xl text-xs sm:text-sm font-black text-[#0B62C4] shadow-[3px_3px_0px_#0B62C4] animate-bounce">
      🧀 Found 4 stores near you! Stocked at Costco & Whole Foods dairy cooler.
    </div>

    <!-- Partner Retailer Badges -->
    <div class="reveal-on-scroll w-full mt-12 flex flex-col items-center">
      <span class="text-xs font-black uppercase text-[#0B62C4] tracking-widest mb-4">
        ✦ PROUDLY STOCKED AT THESE RETAILERS ✦
      </span>
      <div class="flex flex-wrap items-center justify-center gap-3 sm:gap-4">
        {["COSTCO WHOLESALE", "TARGET", "WHOLE FOODS", "SPROUTS", "TRADER JOE'S"].map((retailer) => (
          <div class="bg-[#FFFDF5] text-[#0B62C4] border-3 border-[#0B62C4] px-4 sm:px-6 py-2 rounded-2xl font-bubble text-xs sm:text-sm font-black tracking-wide shadow-[3px_3px_0px_#0B62C4] hover:scale-105 hover:bg-[#FA4616] hover:text-white transition-all cursor-default">
            {retailer}
          </div>
        ))}
      </div>
    </div>

    <!-- Grocer Request Slip -->
    <div class="mt-10 bg-white/70 border-2 border-[#0B62C4]/30 rounded-2xl p-4 max-w-lg text-xs font-bold text-[#0B62C4]/90">
      <span>Don't see Munches in your local store? </span>
      <a href="#hero" class="underline text-[#FA4616] font-black hover:text-[#0B62C4]">
        Download our store request slip
      </a>
      <span> and hand it to your dairy manager!</span>
    </div>

  </div>
</section>

<script is:inline>
  const zipInput = document.getElementById('store-zip-input');
  const searchBtn = document.getElementById('store-search-btn');
  const resultBox = document.getElementById('store-result-box');

  if (searchBtn && zipInput && resultBox) {
    searchBtn.addEventListener('click', () => {
      if (zipInput.value.trim().length >= 3) {
        resultBox.classList.remove('hidden');
        resultBox.textContent = `🧀 Great news! Munches is stocked at 3 retailers near ${zipInput.value.trim()} in the dairy cooler!`;
      } else {
        resultBox.classList.remove('hidden');
        resultBox.textContent = "Please enter a valid zip code to locate stores.";
      }
    });
  }
</script>
