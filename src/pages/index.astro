---
import Layout from '../layouts/Layout.astro';
import BoxFrontHeader from '../components/BoxFrontHeader.astro';
import MarqueeBanner from '../components/MarqueeBanner.astro';
import PocketPackSection from '../components/PocketPackSection.astro';
import MacroSection from '../components/MacroSection.astro';
import WaitlistSection from '../components/WaitlistSection.astro';
import CampaignSection from '../components/CampaignSection.astro';
import StoreLocatorSection from '../components/StoreLocatorSection.astro';
import SiteFooter from '../components/SiteFooter.astro';
import StickyWaitlistBar from '../components/StickyWaitlistBar.astro';
import '../styles/global.css';
---

<Layout title="MUNCHES™ : Original Mozzarella Cheese Sticks | Just a Little Something to Take the Edge Off">
  <main class="w-full min-h-screen bg-[#FFFDF5] overflow-x-hidden">
    <!-- 1. Front-of-Box Hero Section -->
    <BoxFrontHeader />

    <!-- 2. Sunshine Yellow Marquee Ticker -->
    <MarqueeBanner />

    <!-- 3. The Cheese & Macro Cheat Code Matrix (#macros) -->
    <MacroSection />

    <!-- 4. The Whole Milk Cheese Experience & Pocket Pack (#the-pack) -->
    <PocketPackSection />

    <!-- 5. VIP Batch 001 Waitlist & Demand Gauge (#waitlist) -->
    <WaitlistSection />

    <!-- 6. Royal Blue Reverse Marquee Ticker -->
    <MarqueeBanner 
      bgClass="bg-[#0B62C4]" 
      textClass="text-[#FFE042]" 
      borderClass="border-y-3 border-[#0B62C4]" 
      reverse={true} 
      items={[
        "TAKE THE EDGE OFF",
        "NO CHALKY PROTEIN POWDER",
        "100% WISCONSIN WHOLE MILK",
        "7G PROTEIN • 0G SUGAR • 80 CALS",
        "DESK HERO • GYM BUDDY • ROAD TRIP CRUCIAL",
        "PEEL • SNACK • REPEAT ◡",
        "CLEAN ENERGY • ZERO CRASH"
      ]}
    />

    <!-- 7. Official Brand Campaign Showcase (#the-snack) -->
    <CampaignSection />

    <!-- 8. Where to Find Munches Store Locator (#find-stores) -->
    <StoreLocatorSection />

    <!-- 9. Official Brand Site Footer -->
    <SiteFooter />

    <!-- 10. Sticky Conversion Pill for Social/Ad Traffic -->
    <StickyWaitlistBar />
  </main>
</Layout>

